"""
Tool to update machine configuration files in CESM v3

@author Alex Domingo (Vrije Universiteit Brussel)
"""

import argparse
import logging
import os
import shutil
import sys

VERSION = '3.0.0'

MACHINES_CONFIG = 'config_machines.xml'
MACHINES_DIR = 'ccs_config/machines'
MACHINES_NODENAME_ENTRY = '<value MACH="{}">{}</value>'
MACHINES_NODENAME_FILE = 'nodename.regex'
MACHINES_NODENAME_TAG = '<NODENAME_REGEX>'

logging.basicConfig(
    format='%(asctime)s - %(levelname)s: %(message)s', datefmt='%d-%m-%Y %H:%M:%S', level=logging.INFO,
)
logger = logging.getLogger()


def error_exit(message, exc=None):
    """
    Graceful exit on error
    - message: (string) custom error message
    - exc: (Exception) optional exception of the error
    """
    if exc:
        error_message = f"{message}: {exc}"
    else:
        error_message = f"{message}"

    logger.error(error_message)
    logging.shutdown()

    logger.debug("Aborting")
    sys.exit(1)

def inject_machine_nodename(cesm_dir, machine_name):
    """
    Add entry with NODENAME for machine in top config_machines.xml file
    - cesm_dir: path to sources of CESM
    - machine_name: name of machine already installed in CESM
    """
    nodename_regex_path = os.path.join(cesm_dir, MACHINES_DIR, machine_name, MACHINES_NODENAME_FILE)
    if not os.path.exists(nodename_regex_path):
        error_exit(f"Nodename regex for machine '{machine_name}' not found: {nodename_regex_path}")

    with open(nodename_regex_path, 'r') as nodename_regex_file:
        nodename_regex_lines = nodename_regex_file.readlines()

    try:
        nodename_regex_pattern = nodename_regex_lines[0].rstrip('\n')
    except IndexError:
        error_exit(f"Failed to read nodename regex pattern from: {nodename_regex_path}")
    else:
        logger.debug(f"Nodename regex pattern for machine '{machine_name}': {nodename_regex_pattern}")

    top_machines_config = os.path.join(cesm_dir, MACHINES_DIR, MACHINES_CONFIG)
    with open(top_machines_config, 'r') as machines_config_file:
        machines_config_orig = machines_config_file.readlines()
        logger.debug(f"Read file contents of: {top_machines_config}")
    # remove existing entries for this machine
    machines_config_clean = [line for line in machines_config_orig if f'MACH="{machine_name}"' not in line]
    if len(machines_config_orig) != len(machines_config_clean):
        logger.warning(f"Found existing entries for '{machine_name}' in {top_machines_config}. They will be updated")

    with open(top_machines_config, 'w') as machines_config_file:
        for line in machines_config_clean:
            machines_config_file.write(line)
            if MACHINES_NODENAME_TAG in line:
                machine_nodename_entry = MACHINES_NODENAME_ENTRY.format(machine_name, nodename_regex_pattern)
                machines_config_file.write(f'    {machine_nodename_entry}\n')
                logger.debug(f"Added entry for {machine_name} in: {top_machines_config}")


def merge_extra_machines(cesm_dir, extra_machines_dir):
    """
    Add extra settings into CESM.
    Copy extra machine directories and update list of available machines.
    - cesm_dir: path to sources of CESM
    - extra_machines_dir: path to dir with extra machines specs
    """

    cesm_machines_dir = os.path.join(cesm_dir, MACHINES_DIR)
    if not os.path.isdir(cesm_machines_dir):
        error_exit(f"Directory 'machines' not found in CESM sources: {cesm_machines_dir}")

    logger.debug(f"Looking for machine specifications in: {extra_machines_dir}")
    machines = [d for d in os.listdir(extra_machines_dir) if os.path.isdir(os.path.join(extra_machines_dir, d))]
    logger.info(f"Found {len(machines)} machine specifications: {', '.join(machines)}")

    for target_machine in machines:
        # copy all machine directories
        src_machine_dir = os.path.join(extra_machines_dir, target_machine)
        dst_machine_dir = os.path.join(cesm_machines_dir, target_machine)
        if os.path.isdir(dst_machine_dir):
            logger.warning(
                f"Machine '{target_machine}' is already installed. Updating installation in: '{dst_machine_dir}'"
            )

        shutil.copytree(src_machine_dir, dst_machine_dir, dirs_exist_ok=True)
        logger.info(f"Installed new machine '{target_machine}' into '{dst_machine_dir}'")

        # add entry in top config_machines.xml
        inject_machine_nodename(cesm_dir, target_machine)
        logger.info(f"Updated entry for '{target_machine}' in '{MACHINES_CONFIG}'")

def main():
    """ Initialize execution """

    # Parse command line arguments
    cli = argparse.ArgumentParser(
        prog="update-cesm-machines",
        description=(
            "Update machine configuration files in CESM or CTSM with "
            "additional settings from external XML files."
        ),
    )
    cli.add_argument(
        "-d", "--debug", dest="debug", action="store_true", required=False, help="enable debug verbosity",
    )
    cli.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")
    cli.add_argument(
        "extra_machines_path",
        help="path to directory with extra machine files for CESM or CTSM",
    )
    cli.add_argument(
        "-s", "--sources",
        help="path to directory with source code of CESM or CTSM (default: CWD)",
        default=os.getcwd(),
    )
    args = cli.parse_args()

    # Set log level
    if args.debug:
        logger.setLevel(logging.DEBUG)

    if not os.path.isdir(args.extra_machines_path):
        raise NotADirectoryError (f"Option 'extra_machines_path' is not a directory: {args.extra_machines_path}")
    if not os.path.isdir(args.sources):
        raise NotADirectoryError (f"Option '--sources' is not a directory: {args.sources}")

    merge_extra_machines(args.sources, args.extra_machines_path)


if __name__ == "__main__":
    main()
